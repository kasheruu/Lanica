rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Retrieve active user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isStaff() {
      return isSignedIn() && (getUserRole() == 'staff' || getUserRole() == 'admin');
    }

    // Check if user is not trying to change their own role or permissions
    function isNotChangingRole() {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']));
    }

    // --- 1) PRODUCTS ---
    match /products/{productId} {
      allow read: if true;

      // Only authenticated Staff & Admins can create or update products with valid attributes
      allow create, update: if isStaff() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0 &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0;

      // Only Admins can delete catalog products
      allow delete: if isAdmin();
    }

    // --- 2) USERS & USER CHAT SUBCOLLECTIONS ---
    match /users/{userId} {
      allow read: if isSignedIn();

      // Users can update their own profile (cannot elevate role/permissions)
      // Admins can update any profile including roles & permissions
      allow update: if isSignedIn() && (isAdmin() || (request.auth.uid == userId && isNotChangingRole()));

      // Profile creation
      allow create: if isSignedIn();

      // User subcollections (cart, addresses, favorites, notifications, messages)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isStaff());
      }
    }

    // --- 3) ORDERS & ORDER CHAT SUBCOLLECTIONS ---
    match /orders/{orderId} {
      allow read: if isSignedIn();

      // Order creation: Must be signed in, total amount must be non-negative number
      allow create: if isSignedIn() &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount >= 0;

      // Order update: Staff/Admin can update, or customer can update orderReceived/ratings/cancellation/refunds or chat metadata on their own order
      allow update: if isSignedIn() && (
        isStaff() ||
        ((resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'status', 'orderStatus', 'orderReceived', 'orderReceivedAt', 'completedAt',
           'updatedAt', 'rating', 'feedback', 'proofUrl', 'paymentProofUrl',
           'cancelledAt', 'cancellationReason', 'refundStatus', 'refundReason',
           'refundDetails', 'refundRequestedAt',
           'hasUnreadStaff', 'hasUnreadCustomer', 'lastMessage', 'lastMessageAt',
           'lastSenderRole', 'lastSenderName', 'chatStatus', 'isChatClosed'
         ]))
      );

      // Only Admins can permanently delete orders
      allow delete: if isAdmin();

      // Order chat messages subcollection
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Allow collection group queries on messages for order chat and notifications
    match /{path=**}/messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // Order chats collection (used by mobile app & website real-time sync)
    match /order_chats/{orderId} {
      allow read, write: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // --- 4) VERIFICATION COLLECTIONS ---
    match /profile_verifications/{userId} {
      allow create, read, update: if isSignedIn() && (request.auth.uid == userId || isStaff());
    }

    match /photo_verifications/{userId} {
      allow create, read, update: if isSignedIn() && (request.auth.uid == userId || isStaff());
    }

    // --- 5) VERIFICATION CODES ---
    match /verification_codes/{codeId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // --- 6) AUDIT LOGS ---
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }
  }
}
